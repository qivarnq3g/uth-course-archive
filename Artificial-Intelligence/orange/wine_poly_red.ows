		<properties node_id="4" format="literal">{'scriptLibrary': [{'name': 'Polynomial Features d=2', 'script': '# Multivariate polynomial expansion, degree 2.\nimport numpy as np\nfrom Orange.data import ContinuousVariable, Domain, Table\nfrom sklearn.preprocessing import PolynomialFeatures\n\nout_data = None\nif in_data is not None:\n    attrs = tuple(in_data.domain.attributes)\n    if not attrs or not all(isinstance(v, ContinuousVariable) for v in attrs):\n        raise TypeError("All Features must be continuous before polynomial expansion.")\n    if any(v.name == "quality" for v in attrs):\n        raise ValueError("Target leakage: quality is present in Features.")\n\n    transformer = PolynomialFeatures(degree=2, include_bias=False)\n    expanded = transformer.fit_transform(np.asarray(in_data.X, dtype=float))\n    if not np.isfinite(expanded).all():\n        raise ValueError("Polynomial expansion produced NaN or infinity.")\n\n    names = list(transformer.get_feature_names_out([v.name for v in attrs]))\n    if len(names) != len(set(names)):\n        raise ValueError("Polynomial expansion produced duplicate feature names.")\n    variables = tuple(ContinuousVariable(name) for name in names)\n    domain = Domain(variables, in_data.domain.class_vars, in_data.domain.metas)\n    out_data = Table.from_numpy(\n        domain,\n        expanded,\n        in_data.Y,\n        in_data.metas,\n        in_data.W,\n        attributes=dict(in_data.attributes),\n        ids=in_data.ids,\n    )\n', 'filename': None}], 'currentScriptIndex': 0, 'scriptText': '# Multivariate polynomial expansion, degree 2.\nimport numpy as np\nfrom Orange.data import ContinuousVariable, Domain, Table\nfrom sklearn.preprocessing import PolynomialFeatures\n\nout_data = None\nif in_data is not None:\n    attrs = tuple(in_data.domain.attributes)\n    if not attrs or not all(isinstance(v, ContinuousVariable) for v in attrs):\n        raise TypeError("All Features must be continuous before polynomial expansion.")\n    if any(v.name == "quality" for v in attrs):\n        raise ValueError("Target leakage: quality is present in Features.")\n\n    transformer = PolynomialFeatures(degree=2, include_bias=False)\n    expanded = transformer.fit_transform(np.asarray(in_data.X, dtype=float))\n    if not np.isfinite(expanded).all():\n        raise ValueError("Polynomial expansion produced NaN or infinity.")\n\n    names = list(transformer.get_feature_names_out([v.name for v in attrs]))\n    if len(names) != len(set(names)):\n        raise ValueError("Polynomial expansion produced duplicate feature names.")\n    variables = tuple(ContinuousVariable(name) for name in names)\n    domain = Domain(variables, in_data.domain.class_vars, in_data.domain.metas)\n    out_data = Table.from_numpy(\n        domain,\n        expanded,\n        in_data.Y,\n        in_data.metas,\n        in_data.W,\n        attributes=dict(in_data.attributes),\n        ids=in_data.ids,\n    )\n', 'splitterState': None, 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="5" format="literal">{'sampling_type': 0, 'sampleSizePercentage': 70, 'replacement': False, 'use_seed': True, 'stratify': False, 'compatibility_mode': False, '__version__': 2}</properties>
		<properties node_id="6" format="literal">{'ridge': False, 'reg_type': 0, 'alpha_index': 0, 'l2_ratio': 0.5, 'fit_intercept': True, 'autosend': True, 'learner_name': 'Polynomial Linear Regression d=2', '__version__': 1}</properties>
		<properties node_id="8" format="literal">{'scriptLibrary': [{'name': 'Residual d=2', 'script': '# Add residual = actual quality - predicted quality.\nimport numpy as np\nfrom Orange.data import ContinuousVariable, Domain, Table\n\nout_data = None\nif in_data is not None:\n    if in_data.domain.class_var is None or in_data.domain.class_var.name != "quality":\n        raise ValueError("Predictions data must retain numeric target quality.")\n    predicted_vars = [\n        var for var in in_data.domain.metas\n        if isinstance(var, ContinuousVariable) and var.name == \'Polynomial Linear Regression d=2\'\n    ]\n    if len(predicted_vars) != 1:\n        raise ValueError("Could not identify the prediction column uniquely.")\n    predicted = np.asarray(in_data.get_column(predicted_vars[0]), dtype=float)\n    actual = np.asarray(in_data.Y, dtype=float).reshape(-1)\n    residual = actual - predicted\n    if not np.isfinite(residual).all():\n        raise ValueError("Residual contains NaN or infinity.")\n\n    residual_var = ContinuousVariable("residual")\n    meta_vars = (*in_data.domain.metas, residual_var)\n    metas = np.column_stack((in_data.metas, residual))\n    domain = Domain(in_data.domain.attributes, in_data.domain.class_vars, meta_vars)\n    out_data = Table.from_numpy(\n        domain,\n        in_data.X,\n        in_data.Y,\n        metas,\n        in_data.W,\n        attributes=dict(in_data.attributes),\n        ids=in_data.ids,\n    )\n', 'filename': None}], 'currentScriptIndex': 0, 'scriptText': '# Add residual = actual quality - predicted quality.\nimport numpy as np\nfrom Orange.data import ContinuousVariable, Domain, Table\n\nout_data = None\nif in_data is not None:\n    if in_data.domain.class_var is None or in_data.domain.class_var.name != "quality":\n        raise ValueError("Predictions data must retain numeric target quality.")\n    predicted_vars = [\n        var for var in in_data.domain.metas\n        if isinstance(var, ContinuousVariable) and var.name == \'Polynomial Linear Regression d=2\'\n    ]\n    if len(predicted_vars) != 1:\n        raise ValueError("Could not identify the prediction column uniquely.")\n    predicted = np.asarray(in_data.get_column(predicted_vars[0]), dtype=float)\n    actual = np.asarray(in_data.Y, dtype=float).reshape(-1)\n    residual = actual - predicted\n    if not np.isfinite(residual).all():\n        raise ValueError("Residual contains NaN or infinity.")\n\n    residual_var = ContinuousVariable("residual")\n    meta_vars = (*in_data.domain.metas, residual_var)\n    metas = np.column_stack((in_data.metas, residual))\n    domain = Domain(in_data.domain.attributes, in_data.domain.class_vars, meta_vars)\n    out_data = Table.from_numpy(\n        domain,\n        in_data.X,\n        in_data.Y,\n        metas,\n        in_data.W,\n        attributes=dict(in_data.attributes),\n        ids=in_data.ids,\n    )\n', 'splitterState': None, 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="10" format="literal">{'resampling': 5, 'cv_stratified': False, 'shuffle_stratified': False, '__version__': 4}</properties>
		<properties node_id="11" format="literal">{'scriptLibrary': [{'name': 'Polynomial Features d=3', 'script': '# Multivariate polynomial expansion, degree 3.\nimport numpy as np\nfrom Orange.data import ContinuousVariable, Domain, Table\nfrom sklearn.preprocessing import PolynomialFeatures\n\nout_data = None\nif in_data is not None:\n    attrs = tuple(in_data.domain.attributes)\n    if not attrs or not all(isinstance(v, ContinuousVariable) for v in attrs):\n        raise TypeError("All Features must be continuous before polynomial expansion.")\n    if any(v.name == "quality" for v in attrs):\n        raise ValueError("Target leakage: quality is present in Features.")\n\n    transformer = PolynomialFeatures(degree=3, include_bias=False)\n    expanded = transformer.fit_transform(np.asarray(in_data.X, dtype=float))\n    if not np.isfinite(expanded).all():\n        raise ValueError("Polynomial expansion produced NaN or infinity.")\n\n    names = list(transformer.get_feature_names_out([v.name for v in attrs]))\n    if len(names) != len(set(names)):\n        raise ValueError("Polynomial expansion produced duplicate feature names.")\n    variables = tuple(ContinuousVariable(name) for name in names)\n    domain = Domain(variables, in_data.domain.class_vars, in_data.domain.metas)\n    out_data = Table.from_numpy(\n        domain,\n        expanded,\n        in_data.Y,\n        in_data.metas,\n        in_data.W,\n        attributes=dict(in_data.attributes),\n        ids=in_data.ids,\n    )\n', 'filename': None}], 'currentScriptIndex': 0, 'scriptText': '# Multivariate polynomial expansion, degree 3.\nimport numpy as np\nfrom Orange.data import ContinuousVariable, Domain, Table\nfrom sklearn.preprocessing import PolynomialFeatures\n\nout_data = None\nif in_data is not None:\n    attrs = tuple(in_data.domain.attributes)\n    if not attrs or not all(isinstance(v, ContinuousVariable) for v in attrs):\n        raise TypeError("All Features must be continuous before polynomial expansion.")\n    if any(v.name == "quality" for v in attrs):\n        raise ValueError("Target leakage: quality is present in Features.")\n\n    transformer = PolynomialFeatures(degree=3, include_bias=False)\n    expanded = transformer.fit_transform(np.asarray(in_data.X, dtype=float))\n    if not np.isfinite(expanded).all():\n        raise ValueError("Polynomial expansion produced NaN or infinity.")\n\n    names = list(transformer.get_feature_names_out([v.name for v in attrs]))\n    if len(names) != len(set(names)):\n        raise ValueError("Polynomial expansion produced duplicate feature names.")\n    variables = tuple(ContinuousVariable(name) for name in names)\n    domain = Domain(variables, in_data.domain.class_vars, in_data.domain.metas)\n    out_data = Table.from_numpy(\n        domain,\n        expanded,\n        in_data.Y,\n        in_data.metas,\n        in_data.W,\n        attributes=dict(in_data.attributes),\n        ids=in_data.ids,\n    )\n', 'splitterState': None, 'vimModeEnabled': False, '__version__': 2}</properties>
